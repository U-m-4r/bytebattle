PORT=5000
MONGODB_URI=mongodb://localhost:27017/bytebattle
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Judge provider: "mock" (default, no credentials needed) or "judge0" (requires API key below)
JUDGE_PROVIDER=mock

# Judge0 CE via RapidAPI — only required when JUDGE_PROVIDER=judge0
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
# Not needed for mock mode; set your RapidAPI key here when using judge0
JUDGE0_API_KEY=your_rapidapi_key_here

NODE_ENV=development

# Countdown duration in ms before match starts after both players join
DUEL_COUNTDOWN_MS=5000

# Google OAuth (optional — leave blank to disable Google Sign-In)
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
